# ===================
# Environment & Secrets
# ===================
*.env
*.env.bak*
!dragoncp_env_sample.env

# SSH managed known_hosts file (SEC-07, generated at runtime)
dragoncp_known_hosts

# Password for the remote transfer server. Generated by the app, owner-only,
# pushed to the remote host on install. Never a chosen value, never committed.
dragoncp_rsyncd.secret

