# =====================================================================
# DragonCP — environment configuration
# =====================================================================
#
# THIS FILE HOLDS THE CONSTANTS.
#
# Everything here is set once when the installation is built: where the media
# lives, how to reach the remote host, and everything that is a security
# boundary. It is READ-ONLY at runtime — the Settings page shows these values
# but will not change them. Edit this file on the server and restart.
#
# Anything an operator changes while running — auto-sync toggles, Discord
# notifications, backup retention, the realtime timeout — is NOT here. Those
# live in the database and are edited from the Settings page, where they take
# effect immediately and are shared by every operator and every background job.
# `settings_registry.py` is the list of which is which.
#
# If you set a database-backed key here anyway, it is adopted into the database
# once on the next start and then the database is authoritative.
# =====================================================================

# DragonCP Configuration Sample
# Copy this file to dragoncp_env.env and update the values for your environment

# ===== AUTHENTICATION =====
# Administrators live in the database, not here. Add them on the server with:
#     venv/bin/python scripts/manage_admins.py add <username>
# See docs/operations/admin-accounts.md for the full command reference.
#
# The credentials below are the FALLBACK account. They are accepted only while
# no enabled administrator exists in the database, which covers a fresh install,
# an upgrade from the old single-operator setup, and getting back in if every
# account is disabled or the last password is lost. Adding the first account
# switches them off.

# Username for the fallback login
DRAGONCP_USERNAME="admin"

# Password for the fallback login (plain text - for development/simple setups)
DRAGONCP_PASSWORD="your-secure-password-here"

# OR use a hashed password (more secure - generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))")
# DRAGONCP_PASSWORD_HASH=""

# JWT Configuration
JWT_SECRET_KEY="your-jwt-secret-key-here-change-in-production"
JWT_EXPIRY_HOURS=24

# ===== SIGN-IN THROTTLING =====
# Failed sign-ins are counted by client address and by username at the same
# time. Either one reaching the limit locks further attempts for the cooldown,
# and a locked caller never reaches the password check at all. Counters are held
# in memory and clear on restart.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# ===== CORS CONFIGURATION =====
# Comma-separated list of allowed origins for the React frontend
# Use * for development, specific origins for production
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ===== FLASK APPLICATION SETTINGS =====
SECRET_KEY="your-secret-key-here-change-this-in-production"

# ===== REMOTE SERVER CONNECTION =====
REMOTE_IP="X.X.X.X"
REMOTE_USER="username"
REMOTE_PASSWORD="your-password-here"
SSH_KEY_PATH="/path/to/your/private/key"

# ===== SSH HOST-KEY VERIFICATION (SEC-07) =====
# Controls how the remote server's SSH host key is verified (protects against
# man-in-the-middle attacks). Applies to both browsing (paramiko) and rsync.
#   strict      = only connect to hosts already in the known_hosts file (most secure;
#                 provision the key first, e.g. `ssh-keyscan <host> >> <known_hosts>`)
#   accept-new  = trust-on-first-use: record the key on first connect, reject it if
#                 it later CHANGES (DEFAULT — secure yet usable)
#   no          = INSECURE legacy behaviour: accept any key (vulnerable to MITM)
# SSH_HOST_KEY_CHECKING="accept-new"
#
# Path to the managed known_hosts file (must not contain spaces).
# Defaults to <app_dir>/dragoncp_known_hosts when unset.
# SSH_KNOWN_HOSTS_FILE=""

# ===== MEDIA SOURCE PATHS (Remote Server) =====
MOVIE_PATH="/path/to/movies"
TVSHOW_PATH="/path/to/tvshows"
ANIME_PATH="/path/to/anime"

# ===== LOCAL DESTINATION PATHS =====
MOVIE_DEST_PATH="/local/path/to/movies"
TVSHOW_DEST_PATH="/local/path/to/tvshows"
ANIME_DEST_PATH="/local/path/to/anime"

# ===== BACKUP CONFIGURATION =====
# Where displaced media is kept. A sync can replace or delete a file, and the
# copy that was there is moved here first.
#
# REQUIRED. With this unset, transfers refuse to start rather than writing
# backups somewhere a restore will not read them.
BACKUP_PATH="/path/to/backup"

# Backup retention (versions to keep, grace period, on/off) is NOT set here.
# It is a database setting, edited on the Settings page or the Backups page,
# and takes effect without a restart. A value set here is adopted into the
# database once on first start and ignored afterwards.

# ===== WEBHOOK SECURITY =====
# HMAC secret for verifying webhook signatures via X-DragonCP-Signature header.
# When configured, webhook requests must include a valid signature or come from
# a whitelisted IP (if WEBHOOK_ALLOWED_IPS is also set).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WEBHOOK_SECRET=""

# Comma-separated list of allowed webhook source IPs or CIDR ranges.
# Requests from these IPs are allowed through without signature verification.
# Supports individual IPs and CIDR notation (e.g., "192.168.1.0/24").
# Example: "192.168.1.100,10.0.0.0/24,100.64.0.0/10"
# WEBHOOK_ALLOWED_IPS=""

# ===== DISK USAGE MONITORING =====
# Local disk paths to monitor (uses df -h <path>)
DISK_PATH_1="<path>"
DISK_PATH_2="<path>"
DISK_PATH_3="<path>"

# Remote disk usage API (optional)
DISK_API_ENDPOINT="https://api.example.com/disk-usage"
DISK_API_TOKEN="your_bearer_token_here"

# ===== DEV/TEST FLAGS =====
# TEST_MODE keeps rsync in --dry-run (no files are moved) and enables the
# transfer simulator used for UI testing. Leave unset/0 in production.
# TEST_MODE="0"
